          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-event.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-event.sh",
            "timeout": 3
          }
        ]
      }
    ]
